# ==========================================
# The Artist Network — Comprehensive .gitignore
# ==========================================

# --- Dependencies & Package Managers ---
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn-cache/
.npm

# --- Next.js, Turbopack & Build Outputs ---
.next/
/.next/
out/
/out/
build/
/build
dist/
/dist
.turbo/
.cache/

# --- Environment & Secret Credentials ---
# Never commit production secrets, service role keys, or database passwords
.env*
!.env.example
*.local
.test-credentials.local

# --- SSL Certificates & Private Keys ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Debug, Process & Application Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
/coverage
*.lcov
.nyc_output

# --- Local Scratch & Temp Directories ---
scratch/
tmp/
temp/
*.tmp
*.temp

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows (Crucial for OneDrive & Windows development)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.fuse_hidden*

# --- IDEs & Code Editors ---
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log

# JetBrains / WebStorm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Sublime Text / Atom / Eclipse / Vim
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Cloud & Deployment Tooling ---
.vercel
.serverless/

# --- TypeScript & Linter Caches ---
*.tsbuildinfo
.eslintcache
next-env.d.ts

# --- Supabase CLI Local Tooling (if used) ---
.supabase/
